---
/**
 * Componente de Divulgação de Afiliado (ClickBank & FTC Disclosure).
 *
 * Exibe avisos de transparência exigidos pelas diretrizes da FTC (Federal Trade Commission)
 * e pelos termos de conformidade e uso de marcas da ClickBank (Click Sales, Inc.).
 */
import {
  getFtcDisclosure,
  getClickbankDisclaimer,
  getFdaDisclaimer,
} from '../utils/affiliate';

interface Props {
  variant?: 'banner' | 'compact' | 'card' | 'legal';
  className?: string;
  showFda?: boolean;
}

const {
  variant = 'banner',
  className = '',
  showFda = false,
} = Astro.props;

const ftcText = getFtcDisclosure();
const cbText = getClickbankDisclaimer();
const fdaText = getFdaDisclaimer();
---

{variant === 'banner' && (
  <aside 
    class={`bg-emerald-50/90 border border-emerald-200/90 rounded-2xl p-4 sm:p-5 text-xs sm:text-sm text-emerald-950 shadow-2xs flex items-start gap-3 my-6 ${className}`}
    aria-label="Affiliate Disclosure"
  >
    <div class="mt-0.5 text-emerald-700 shrink-0" aria-hidden="true">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div class="leading-relaxed">
      <span class="font-bold text-emerald-950 uppercase tracking-wider text-[11px] block sm:inline mr-1">
        Transparency & FTC Disclosure:
      </span>
      <span>{ftcText}</span>
    </div>
  </aside>
)}

{variant === 'compact' && (
  <div class={`text-[11px] text-slate-500 italic py-1 border-b border-slate-100 ${className}`}>
    <span>Reader-Supported: When you buy through our links, we may earn a commission at no extra cost to you. Backed by ClickBank's 60-day refund policy.</span>
  </div>
)}

{variant === 'card' && (
  <div class={`bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs text-slate-600 space-y-2 ${className}`}>
    <p class="font-semibold text-slate-800">Affiliate Partnership & Editorial Disclosure</p>
    <p>{ftcText}</p>
    <p class="text-[11px] text-slate-500">{cbText}</p>
    {showFda && <p class="text-[11px] text-slate-500 italic">{fdaText}</p>}
  </div>
)}

{variant === 'legal' && (
  <div class={`border-t border-slate-200 pt-6 mt-8 space-y-3 text-xs text-slate-500 leading-relaxed ${className}`}>
    <p>
      <strong class="text-slate-700">FTC Compliance:</strong> {ftcText}
    </p>
    <p>
      <strong class="text-slate-700">ClickBank Disclaimer:</strong> {cbText}
    </p>
    {showFda && (
      <p>
        <strong class="text-slate-700">FDA Notice:</strong> {fdaText}
      </p>
    )}
  </div>
)}
